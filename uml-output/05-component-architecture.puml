@startuml
title 适老化打车平台 - 组件架构图 (Component Diagram)

package "App Layer" {
    [HomeScreen]
    [VoiceBookingScreen]
    [QRBookingScreen]
    [HotlineBookingScreen]
    [RideStatusScreen]
    [FamilyPayScreen]
    [SettingsScreen]
    [HistoryScreen]
    [ProfileScreen]
}

package "Elderly UI Components" {
    [ElderlyButton]
    [OneTapCard]
    [LargeText]
    [ElderlyTextInput]
    [ElderlyModal]
    [ElderlyBottomNav]
    [ElderlyVoiceInput]
    [SOSButton]
    [LiveLocationCard]
}

package "Service Layer" {
    [VoiceService]
    [RideService]
    [PaymentService]
    [SafetyService]
}

package "Theme & State" {
    [ElderlyThemeProvider]
    [AsyncStorage]
}

package "External APIs" {
    [Speech-to-Text API]
    [TTS API]
    [Ride Backend API]
    [Payment Gateway]
    [SMS Service]
    [Emergency Service API]
    [QR Code Scanner]
    [Hotline 95128]
}

[HomeScreen] --> [OneTapCard]
[HomeScreen] --> [ElderlyButton]
[HomeScreen] --> [ElderlyBottomNav]

[VoiceBookingScreen] --> [ElderlyVoiceInput]
[VoiceBookingScreen] --> [ElderlyModal]
[VoiceBookingScreen] --> [ElderlyButton]

[QRBookingScreen] --> [QR Code Scanner]
[QRBookingScreen] --> [ElderlyButton]
[HotlineBookingScreen] --> [Hotline 95128]

[RideStatusScreen] --> [ElderlyButton]
[RideStatusScreen] --> [LiveLocationCard]
[RideStatusScreen] --> [SOSButton]
[RideStatusScreen] --> [ElderlyModal]

[FamilyPayScreen] --> [ElderlyButton]
[SettingsScreen] --> [ElderlyButton]

[VoiceBookingScreen] --> [VoiceService]
[RideStatusScreen] --> [VoiceService]

[VoiceBookingScreen] --> [RideService]
[QRBookingScreen] --> [RideService]
[HotlineBookingScreen] --> [RideService]
[RideStatusScreen] --> [RideService]

[RideStatusScreen] --> [SafetyService]

[FamilyPayScreen] --> [PaymentService]

[HomeScreen] --> [ElderlyThemeProvider]
[SettingsScreen] --> [ElderlyThemeProvider]

[VoiceService] --> [Speech-to-Text API]
[VoiceService] --> [TTS API]

[RideService] --> [Ride Backend API]

[PaymentService] --> [Payment Gateway]
[PaymentService] --> [SMS Service]

[SafetyService] --> [Ride Backend API]
[SafetyService] --> [Emergency Service API]
[SafetyService] --> [SMS Service]

[ElderlyThemeProvider] --> [AsyncStorage]

note right of [ElderlyThemeProvider]
  管理字体缩放、
  高对比度、
  减少动画等设置
end note

note bottom of [VoiceService]
  单例服务
  支持语音输入和
  语音播报反馈
end note

note bottom of [SafetyService]
  新增安全服务模块
  行程守护 / 车牌校验
  SOS紧急求助
  实时位置共享
end note

note right of [RideService]
  就医优先派单
  无接单自动扩范围
end note
@enduml
