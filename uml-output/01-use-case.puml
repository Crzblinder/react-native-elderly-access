@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

title 适老化打车平台 - 用例图 (Use Case Diagram)

actor "老年用户\n(Elderly User)" as Elderly #LightBlue
actor "司机\n(Driver)" as Driver #LightGreen
actor "亲友用户\n(Family Member)" as Family #LightYellow

rectangle "适老化打车平台\n(Elderly Taxi Platform)" {
    usecase "UC1: 一键叫车\n(One-Tap Ride)" as UC1
    usecase "UC2: 语音叫车\n(Voice Command Ride)" as UC2
    usecase "UC3: 查看行程状态\n(Check Ride Status)" as UC3
    usecase "UC4: 设置大字模式\n(Large Text Settings)" as UC4
    usecase "UC5: 亲友代付\n(Family Payment)" as UC5
    usecase "UC6: 接单\n(Accept Order)" as UC6
    usecase "UC7: 导航\n(Navigation)" as UC7
    usecase "UC8: 代付确认\n(Confirm Payment)" as UC8
    usecase "UC9: 行程查看\n(View Trip History)" as UC9
}

Elderly --> UC1
Elderly --> UC2
Elderly --> UC3
Elderly --> UC4
Elderly --> UC5

Driver --> UC6
Driver --> UC7

Family --> UC8
Family --> UC9

UC5 ..> UC8 : <<include>>
UC3 ..> UC9 : <<extend>>

note right of UC2
  支持语音指令：
  - "我要打车回家"
  - "打车去[地点]"
  - "取消叫车"
end note

note bottom of UC4
  字体缩放 1.0x - 2.0x
  高对比度模式
end note

note bottom of UC1
  预填家庭地址
  一键完成叫车
end note
@enduml
